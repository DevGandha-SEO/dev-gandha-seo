---
/**
 * One service. Kept separate from the section that lists them so the card can
 * be reused on a future services index or detail page without extraction work.
 */
import Asterisk from '../ui/Asterisk.astro';
import Icon from '../ui/Icon.astro';
import type { Service } from '../../types';

interface Props {
  service: Service;
  /** Zero-based position, used for the counter and the reveal stagger. */
  index: number;
}

const { service, index } = Astro.props;
const counter = String(index + 1).padStart(2, '0');
---

<article
  id={service.id}
  data-reveal
  style={`--reveal-delay:${index * 90}ms`}
  class="group relative flex h-full flex-col overflow-hidden rounded-3xl bg-surface-raised p-6 shadow-card transition duration-500 ease-out-soft md:p-8 motion-safe:hover:-translate-y-1.5 hover:shadow-lift"
>
  <!-- Accent bar wipes in from the left on hover -->
  <span
    aria-hidden="true"
    class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-orange-600 transition-transform duration-500 ease-out-soft group-hover:scale-x-100"
  ></span>

  <div class="flex items-start justify-between gap-4">
    <Asterisk size={30} class="text-orange-600" />
    <span class="text-sm font-black tabular-nums text-content/25">
      {counter}
    </span>
  </div>

  <h3 class="mt-6 text-h3 font-black tracking-tight uppercase sm:text-h2">
    {service.title}
  </h3>

  <p class="mt-3 text-content-muted">{service.description}</p>

  <!-- `mt-auto` pins the chips to the bottom so cards of differing text
       length still line their chip rows up across the grid. -->
  <ul role="list" class="mt-auto flex flex-wrap gap-2 pt-6">
    {
      service.highlights.map((highlight) => (
        <li class="inline-flex items-center gap-1.5 rounded-full bg-navy-900/5 px-3 py-1.5 text-xs font-semibold text-content-muted">
          <Icon name="check" size={14} class="text-orange-700" />
          {highlight}
        </li>
      ))
    }
  </ul>
</article>
