---
/**
 * Site footer.
 *
 * Link columns are rendered from FOOTER_NAV, so adding a group is a config
 * change and the grid grows to match. `surface="dark"` handles every colour.
 */
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import Asterisk from '../ui/Asterisk.astro';
import KeywordRail from '../ui/KeywordRail.astro';
import Wordmark from '../ui/Wordmark.astro';
import { FOOTER } from '../../config/content';
import { FOOTER_NAV, SITE, SOCIAL_LINKS } from '../../config/site';

const year = new Date().getFullYear();
---

<footer
  data-surface="dark"
  class="relative overflow-hidden bg-surface pt-16 text-content"
>
  <Container>
    <KeywordRail items={FOOTER.keywords} bordered />

    <!-- Statement + back to top -->
    <div class="flex flex-col items-center gap-8 py-14 text-center">
      <p data-reveal class="max-w-2xl text-lead font-medium text-content-muted">
        {FOOTER.blurb}
      </p>

      <a
        href="#top"
        data-reveal
        style="--reveal-delay:80ms"
        class="group inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-bold tracking-wide text-accent-contrast uppercase transition duration-300 ease-out-soft hover:bg-accent-hover motion-safe:hover:-translate-y-0.5"
      >
        Back to top
        <Icon
          name="arrow-right"
          size={16}
          class="-rotate-90 transition-transform duration-300 ease-out-soft motion-safe:group-hover:-translate-y-0.5"
        />
      </a>
    </div>

    <!-- Link columns -->
    <div
      class="grid grid-cols-2 gap-10 border-t border-edge py-14 md:grid-cols-4"
    >
      <div class="col-span-2 md:col-span-1">
        <a
          href="#top"
          class="group inline-flex items-center gap-2.5 font-black tracking-tight uppercase"
        >
          <Asterisk size={20} class="text-accent" />
          {SITE.name}
        </a>
        <p class="mt-3 text-sm text-content-muted">{SITE.tagline}</p>
        <p class="mt-4 text-sm text-content-muted">{SITE.location}</p>
        <a
          href={`mailto:${SITE.email}`}
          class="mt-1 inline-block text-sm font-semibold text-accent underline-offset-4 transition-colors duration-200 hover:underline"
        >
          {SITE.email}
        </a>
      </div>

      {
        FOOTER_NAV.map((group) => (
          <nav aria-label={group.title}>
            <h2 class="text-xs font-bold tracking-[0.18em] text-content uppercase">
              {group.title}
            </h2>
            <ul role="list" class="mt-4 flex flex-col gap-2.5">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                    class="inline-flex items-center gap-1 text-sm text-content-muted transition-colors duration-200 hover:text-accent"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </Container>

  <!-- Ghosted wordmark, bled to the full width -->
  <Wordmark text={FOOTER.wordmark} variant="ghost" class="mt-4" />

  <!-- Bottom bar -->
  <Container>
    <div
      class="flex flex-col items-center justify-between gap-4 border-t border-edge py-6 text-sm text-content-muted sm:flex-row"
    >
      <p>{FOOTER.note}</p>

      <ul role="list" class="flex items-center gap-2">
        {
          SOCIAL_LINKS.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex size-9 items-center justify-center rounded-full border border-edge text-content-muted transition duration-300 ease-out-soft hover:border-accent hover:text-accent motion-safe:hover:-translate-y-0.5"
              >
                <span class="sr-only">{social.label}</span>
                <Icon name={social.icon} size={16} />
              </a>
            </li>
          ))
        }
      </ul>

      <p>&copy; {year} {SITE.name}</p>
    </div>
  </Container>
</footer>
