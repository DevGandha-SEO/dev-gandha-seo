---
/**
 * The orange colour block.
 *
 * `surface="accent"` is the only colour decision made here — every child
 * recolours itself from the remapped tokens, which is why there is not a
 * single hardcoded hex or `dark:` variant in this file.
 */
import Section from '../ui/Section.astro';
import ServiceCard from '../cards/ServiceCard.astro';
import Pill from '../ui/Pill.astro';
import { SERVICES, SERVICES_SECTION } from '../../config/content';
---

<Section
  id="services"
  surface="accent"
  containerSize="wide"
  labelledby="services-title"
  class="overflow-hidden"
>
  <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div>
      <Pill tone="outline" data-reveal>{SERVICES_SECTION.eyebrow}</Pill>
      <h2
        id="services-title"
        data-reveal
        style="--reveal-delay:80ms"
        class="mt-5 text-hero font-black uppercase"
      >
        {SERVICES_SECTION.title}
      </h2>
    </div>

    <p
      data-reveal
      style="--reveal-delay:160ms"
      class="max-w-md text-lead font-medium text-content-muted"
    >
      {SERVICES_SECTION.description}
    </p>
  </div>

  <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 md:mt-16">
    {SERVICES.map((service, index) => <ServiceCard service={service} index={index} />)}
  </div>
</Section>
