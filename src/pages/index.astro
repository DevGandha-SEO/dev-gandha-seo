---
/**
 * Homepage.
 *
 * Deliberately thin: it composes sections and declares its SEO, nothing more.
 * All structure lives in BaseLayout, all copy in src/config/content.ts. Adding
 * a section here is one import and one tag.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Services from '../components/sections/Services.astro';
import { SEO_DEFAULTS } from '../config/seo';
---

<BaseLayout
  seo={{
    // The homepage title is already brand-complete, so skip the
    // "%s | Dev Gandha" template rather than doubling the brand name.
    title: SEO_DEFAULTS.defaultTitle,
    rawTitle: true,
    canonical: '/',
  }}
>
  <Hero />
  <Services />
</BaseLayout>
